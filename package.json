  "description": "Sub2API 用量面板：在 DSH 左侧边栏显示余额/用量摘要，点开是完整用量详情，查询接口（服务地址、模式、路径、字段指针）全部可自定义。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sub2api",
    "usage",
    "balance"
  ],
  "engines": {
    "node": ">=18"
  },
